# Copy these values into the EasyPanel Compose service environment editor.
DATABASE_URL=postgresql://user:password@internal-postgres-host:5432/skip_the_trip
APP_DOMAIN=staging.example.com
APP_RELEASE=staging-YYYYMMDD-1
APP_REVISION=replace-with-full-40-character-approved-git-commit-sha
LOCATION_MAX_ACCURACY_METERS=100
LOCATION_LATITUDE=51.907327
LOCATION_LONGITUDE=-8.513503
LOCATION_RADIUS_METERS=500
LOG_LEVEL=info
REPORT_WINDOW_MINUTES=30
REPORT_RETENTION_DAYS=30
RETENTION_INTERVAL_HOURS=24
RETENTION_FAILURE_THRESHOLD=3
VOTE_COOLDOWN_SECONDS=300
GLITCHTIP_WEB_DSN=
GLITCHTIP_SERVER_DSN=
GOOGLE_ANALYTICS_ID=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
VITE_OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=skip-the-trip-api
VITE_OTEL_SERVICE_NAME=skip-the-trip-web
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-numeric-chat-id
