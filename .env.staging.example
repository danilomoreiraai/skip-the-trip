# Use a long URL-safe value because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-value
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
LOG_LEVEL=info
REPORT_WINDOW_MINUTES=30
REPORT_RETENTION_DAYS=30
VOTE_COOLDOWN_SECONDS=300
LOCATION_MAX_ACCURACY_METERS=100
LOCATION_LATITUDE=51.907327
LOCATION_LONGITUDE=-8.513503
LOCATION_RADIUS_METERS=500
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
ALERTMANAGER_PORT=9093
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-value

# Create separate React and Node projects in GlitchTip, then paste their DSNs.
GLITCHTIP_WEB_DSN=
GLITCHTIP_SERVER_DSN=
GOOGLE_ANALYTICS_ID=
APP_RELEASE=local
APP_REVISION=local

# Cleaner operations remain disabled until operator onboarding is ready.
STAFF_ENABLED=false

# Optional Web Push; provide keys privately before enabling.
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@skipthetrip.info
PUSH_ENCRYPTION_KEY=
